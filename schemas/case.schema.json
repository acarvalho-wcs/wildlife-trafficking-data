{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acarvalho-wcs.github.io/wildlife-trafficking-data/schemas/case.schema.json",
  "title": "Illegal Wildlife Trafficking Global Observatory case",
  "type": "object",
  "required": [
    "id",
    "location_label_pt",
    "country",
    "publication_date",
    "fauna_label_pt",
    "taxon_text",
    "modal_primary",
    "card_text_pt",
    "status",
    "coordinates",
    "coordinate_precision",
    "source_label",
    "source_url",
    "event_date",
    "fauna_groups_aggregated",
    "aggregate_operation",
    "exclude_from_totals",
    "title_pt",
    "title_en",
    "title_es",
    "card_text_en",
    "card_text_es",
    "context_pt",
    "context_en",
    "context_es"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "legacy_index": {
      "type": [
        "integer",
        "null"
      ]
    },
    "location_label_pt": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "title_pt": {
      "type": "string",
      "minLength": 1
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "title_es": {
      "type": "string",
      "minLength": 1
    },
    "source_label": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "publication_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "event_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "fauna_label_pt": {
      "type": [
        "string",
        "null"
      ]
    },
    "taxon_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "fauna_groups_aggregated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modal_label_pt": {
      "type": [
        "string",
        "null"
      ]
    },
    "modal_primary": {
      "type": "string"
    },
    "card_text_pt": {
      "type": "string",
      "minLength": 1
    },
    "card_text_en": {
      "type": "string",
      "minLength": 1
    },
    "card_text_es": {
      "type": "string",
      "minLength": 1
    },
    "coordinates": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "coordinate_precision": {
      "type": "string",
      "minLength": 1
    },
    "geographic_note_pt": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_pt": {
      "type": "string",
      "minLength": 1
    },
    "context_en": {
      "type": "string",
      "minLength": 1
    },
    "context_es": {
      "type": "string",
      "minLength": 1
    },
    "references_text_pt": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "const": "VALIDATED"
    },
    "aggregate_operation": {
      "type": "boolean"
    },
    "exclude_from_totals": {
      "type": "boolean"
    },
    "migration_status": {
      "type": "string"
    },
    "quantity_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Countable animals or wildlife items. Never derived from weight/volume."
    },
    "quantity_qualifier": {
      "type": "string",
      "enum": [
        "exact",
        "approximate",
        "minimum",
        "unknown"
      ]
    },
    "quantity_kind": {
      "type": "string",
      "enum": [
        "animals",
        "wildlife_items",
        "animals_and_items",
        "unknown"
      ]
    },
    "quantity_by_group": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Known numeric allocation across dashboard fauna groups."
    },
    "quantity_unassigned": {
      "type": "integer",
      "minimum": 0,
      "description": "Known count not safely allocable to a dashboard fauna group."
    },
    "quantity_note_pt": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "image_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "Direct renderable image URL when independently resolved."
    },
    "image_source_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "Source-hosted image page or media reference when available."
    },
    "image_caption_pt": {
      "type": [
        "string",
        "null"
      ]
    },
    "image_credit": {
      "type": [
        "string",
        "null"
      ]
    },
    "image_status": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "x-schema-version": "1.2"
}
